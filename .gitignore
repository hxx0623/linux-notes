# ──────────────────────────────────────────────
#  Git 忽略清单 (.gitignore)
#  作用：这些文件/目录永远不会被 git 跟踪，也不会推上 GitHub
#  改完这个文件不需要任何命令，git 下次看目录时自动遵守
# ──────────────────────────────────────────────

# ── 临时素材（截图、中转文件，可随时清空，不入库）──
99-临时素材/

# ── Windows / macOS 系统自动生成的垃圾文件 ──
Thumbs.db
desktop.ini
.DS_Store

# ── Python 缓存（跑过 pdf-to-text.py 之后会出现）──
__pycache__/
*.pyc

# ── 编辑器临时文件与备份 ──
*.bak
*.bak-*
*.orig
*.swp
*~

# ── 课件原始 PDF（体积大；抽出来的 txt 已入库，原件不必重复）──
*.pdf

# vendor manual fulltext: local only, never commit
opi5-manual-fulltext.txt

